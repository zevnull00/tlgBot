{
  "name": "zevnull-reg-ai-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Telegram conversational client for REG.RU AI Models on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
