    "db:migrate:remote": "wrangler d1 migrations apply tlgbot-db --remote"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "unpdf": "2.2.1"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
